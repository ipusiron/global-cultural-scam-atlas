{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "last_updated", "countries"],
  "properties": {
    "version": { "type": "string" },
    "last_updated": { "type": "string", "format": "date" },
    "countries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["country_code","country_name_local","country_name_en","attacks"],
        "properties": {
          "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "country_name_local": { "type": "string" },
          "country_name_en": { "type": "string" },
          "regions": { "type": "array", "items": { "type": "string" } },
          "language_codes": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" },
          "attacks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id","title","short_desc","cultural_lever","attack_vector","targets","scenario","red_flags","mitigations","risk_score","tags"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z]{2}-\\d{3}$" },
                "title": {
                  "type": "object",
                  "required": ["ja"],
                  "properties": { "ja": { "type": "string" }, "en": { "type": "string" } }
                },
                "short_desc": {
                  "type": "object",
                  "required": ["ja"],
                  "properties": { "ja": { "type": "string" }, "en": { "type": "string" } }
                },
                "cultural_lever": {
                  "type": "object",
                  "required": ["ja"],
                  "properties": { "ja": { "type": "string" }, "en": { "type": "string" } }
                },
                "attack_vector": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "enum": ["in-person","phone","email","sms","social","website","payment-app","postal","door-to-door","marketplace","mixed"]
                  }
                },
                "targets": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "enum": ["tourist","general","elderly","business","student","expat"]
                  }
                },
                "scenario": {
                  "type": "object",
                  "required": ["ja"],
                  "properties": { "ja": { "type": "string" }, "en": { "type": "string" } }
                },
                "red_flags": {
                  "type": "object",
                  "required": ["ja"],
                  "properties": {
                    "ja": { "type": "array", "items": { "type": "string" } },
                    "en": { "type": "array", "items": { "type": "string" } }
                  }
                },
                "mitigations": {
                  "type": "object",
                  "required": ["ja"],
                  "properties": {
                    "ja": { "type": "array", "items": { "type": "string" } },
                    "en": { "type": "array", "items": { "type": "string" } }
                  }
                },
                "risk_score": { "type": "integer", "minimum": 1, "maximum": 5 },
                "mediums": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": ["cash","credit","bank-transfer","cryptocurrency","gift-cards","e-wallet","qr-pay"]
                  }
                },
                "legal_notes": {
                  "type": "object",
                  "properties": { "ja": { "type": "string" }, "en": { "type": "string" } }
                },
                "references": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["label","url"],
                    "properties": {
                      "label": { "type": "string" },
                      "url": { "type": "string", "format": "uri" },
                      "publisher": { "type": "string" },
                      "accessed": { "type": "string", "format": "date" },
                      "quote": { "type": "string" }
                    }
                  }
                },
                "tags": { "type": "array", "items": { "type": "string" } },
                "verification": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": { "type": "string", "enum": ["verified","partial","unverified"] },
                    "checked": { "type": "string", "format": "date" },
                    "note": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
